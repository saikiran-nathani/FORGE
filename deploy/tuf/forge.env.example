# FORGE API settings on the TUF. install.sh copies this to ~/.config/forge/forge.env
# (mode 600) the first time; edit that copy, then: systemctl --user restart forge-api

# REQUIRED: your Netlify site's origin — scheme + host, no trailing slash, no path.
# Only this site may call the API from a browser. install.sh refuses to start
# the service while this still says REPLACE-ME.
FORGE_CORS_ORIGINS=https://REPLACE-ME.netlify.app

# Limits for the public endpoint (see forge/api/settings.py).
FORGE_MAX_UPLOAD_MB=25
FORGE_MAX_TRIALS=30
FORGE_MAX_CONCURRENT_RUNS=1

# Match native thread pools (LightGBM/XGBoost/BLAS) to the unit's 8-core CPUQuota,
# so a training job doesn't oversubscribe and thrash.
OMP_NUM_THREADS=8
OPENBLAS_NUM_THREADS=8
PYTHONUNBUFFERED=1

# Deliberately NOT set: OPENAI_API_KEY / ANTHROPIC_API_KEY. This endpoint is public,
# so a key here would let any visitor spend your LLM credits. Without one, FORGE
# uses its deterministic heuristic fallbacks, which is the same path the demo uses.
